# Copy this file to .env.local and adjust it for your machine.
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put a secret here: everything in this file ships to the client.

# Base URL of the Spring Boot API. Keep /api in development: vite.config.js
# proxies it to Spring Boot on http://localhost:8080, so the backend needs no
# CORS and a phone on the same network can reach it. Use a full URL only when
# the API is served from another origin, which then needs CORS on the backend.
VITE_API_URL=/api

# While the backend does not exist, serve the menu from src/data/menuData.js.
# Set to false once GET /api/menu is live, then restart the dev server.
VITE_USE_MOCK_MENU=true
